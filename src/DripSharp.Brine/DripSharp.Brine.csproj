<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0108;CS0109;CS0162;CS0414;CS0436;CS0649;CS0693;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8619;CS8620;CS8629;CS8714;CS8764;CS8765;CS8767</NoWarn>
    <DefineConstants>$(DefineConstants);DRIPSHARP_INTERNAL_JAVA_COMPAT</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DripSharp.Brine</AssemblyName>
    <RootNamespace>DripSharp.Brine</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PackageId>DripSharp.Brine</PackageId>
    <Version>0.32.0-alpha.1</Version>
    <Title>Brine — Pkl for .NET</Title>
    <Description>Brine is a Pkl evaluation, runtime, and value-model library for .NET, generated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by Apple Inc.</Description>
    <Authors>Isak Sky</Authors>
    <Copyright>Portions Copyright Apple Inc. and other Pkl contributors; see NOTICE.txt.</Copyright>
    <PackageTags>brine pkl evaluator runtime value-model dotnet dripsharp</PackageTags>
    <PackageProjectUrl>https://github.com/dripsharp/brine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dripsharp/brine.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <SourceRoot Include="$(MSBuildProjectDirectory)/" RepositoryUrl="https://github.com/dripsharp/brine.git" SourceControl="git" RevisionId="$(RepositoryCommit)" SourceLinkUrl="https://raw.githubusercontent.com/dripsharp/brine/$(RepositoryCommit)/src/DripSharp.Brine/*" />
    <ProjectReference Include="../DripSharp.Brine.Parser/DripSharp.Brine.Parser.csproj" />
    <EmbeddedResource Include="resources/META-INF/services/java.nio.file.spi.FileTypeDetector" LogicalName="META-INF.services.java.nio.file.spi.FileTypeDetector" />
    <EmbeddedResource Include="resources/META-INF/services/org.pkl.executor.spi.v1.ExecutorSpi" LogicalName="META-INF.services.org.pkl.executor.spi.v1.ExecutorSpi" />
    <EmbeddedResource Include="resources/org/pkl/core/Release.properties" LogicalName="org.pkl.core.Release.properties" />
    <EmbeddedResource Include="resources/org/pkl/core/errorMessages.properties" LogicalName="org.pkl.core.errorMessages.properties" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/Benchmark.pkl" LogicalName="org.pkl.core.stdlib.Benchmark.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/Command.pkl" LogicalName="org.pkl.core.stdlib.Command.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/DocPackageInfo.pkl" LogicalName="org.pkl.core.stdlib.DocPackageInfo.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/DocsiteInfo.pkl" LogicalName="org.pkl.core.stdlib.DocsiteInfo.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/EvaluatorSettings.pkl" LogicalName="org.pkl.core.stdlib.EvaluatorSettings.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/Project.pkl" LogicalName="org.pkl.core.stdlib.Project.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/analyze.pkl" LogicalName="org.pkl.core.stdlib.analyze.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/base.pkl" LogicalName="org.pkl.core.stdlib.base.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/doc-package-info.pkl" LogicalName="org.pkl.core.stdlib.doc-package-info.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/json.pkl" LogicalName="org.pkl.core.stdlib.json.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/jsonnet.pkl" LogicalName="org.pkl.core.stdlib.jsonnet.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/math.pkl" LogicalName="org.pkl.core.stdlib.math.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/pklbinary.pkl" LogicalName="org.pkl.core.stdlib.pklbinary.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/platform.pkl" LogicalName="org.pkl.core.stdlib.platform.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/protobuf.pkl" LogicalName="org.pkl.core.stdlib.protobuf.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/ref.pkl" LogicalName="org.pkl.core.stdlib.ref.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/reflect.pkl" LogicalName="org.pkl.core.stdlib.reflect.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/release.pkl" LogicalName="org.pkl.core.stdlib.release.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/semver.pkl" LogicalName="org.pkl.core.stdlib.semver.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/settings.pkl" LogicalName="org.pkl.core.stdlib.settings.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/shell.pkl" LogicalName="org.pkl.core.stdlib.shell.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/test.pkl" LogicalName="org.pkl.core.stdlib.test.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/xml.pkl" LogicalName="org.pkl.core.stdlib.xml.pkl" />
    <EmbeddedResource Include="resources/org/pkl/core/stdlib/yaml.pkl" LogicalName="org.pkl.core.stdlib.yaml.pkl" />
    <None Include="src/Legal/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    <None Include="src/Legal/NOTICE.txt" Pack="true" PackagePath="NOTICE.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
