<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);DRIPSHARP_INTERNAL_JAVA_COMPAT</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DripSharp.Brine.Parser</AssemblyName>
    <RootNamespace>DripSharp.Brine.Parser</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PackageId>DripSharp.Brine.Parser</PackageId>
    <Version>0.32.0-alpha.1</Version>
    <Title>Brine Parser — Pkl for .NET</Title>
    <Description>Brine Parser is a Pkl parser library for .NET, generated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by Apple Inc.</Description>
    <Authors>Isak Sky</Authors>
    <Copyright>Portions Copyright Apple Inc. and other Pkl contributors; see NOTICE.txt.</Copyright>
    <PackageTags>brine pkl parser dotnet dripsharp</PackageTags>
    <PackageProjectUrl>https://github.com/dripsharp/brine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dripsharp/brine.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <SourceRoot Include="$(MSBuildProjectDirectory)/" RepositoryUrl="https://github.com/dripsharp/brine.git" SourceControl="git" RevisionId="$(RepositoryCommit)" SourceLinkUrl="https://raw.githubusercontent.com/dripsharp/brine/$(RepositoryCommit)/src/DripSharp.Brine.Parser/*" />
    <EmbeddedResource Include="resources/org/pkl/parser/errorMessages.properties" LogicalName="org.pkl.parser.errorMessages.properties" />
    <None Include="src/Legal/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    <None Include="src/Legal/NOTICE.txt" Pack="true" PackagePath="NOTICE.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
