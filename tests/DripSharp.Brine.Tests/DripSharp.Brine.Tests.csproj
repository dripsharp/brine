<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DripSharp.Brine.Tests</AssemblyName>
    <RootNamespace>DripSharp.Brine.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DripSharp.Brine.Parser/DripSharp.Brine.Parser.csproj" />
    <ProjectReference Include="../../src/DripSharp.Brine/DripSharp.Brine.csproj" />
    <ProjectReference Include="../DripSharp.Brine.LanguageSnippetRunner/DripSharp.Brine.LanguageSnippetRunner.csproj" />
    <ProjectReference Include="../DripSharp.Brine.CoreTestRunner/DripSharp.Brine.CoreTestRunner.csproj" />
    <ProjectReference Include="../DripSharp.Brine.ParserTestRunner/DripSharp.Brine.ParserTestRunner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/sample.pkl" TargetPath="Fixtures/sample.pkl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
