<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DripSharp.Brine.LanguageSnippetRunner</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DripSharp.Brine/DripSharp.Brine.csproj" />
    <ProjectReference Include="../../src/DripSharp.Brine.Parser/DripSharp.Brine.Parser.csproj" />
  </ItemGroup>
</Project>
